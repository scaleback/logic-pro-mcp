<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Batuta fix (Fase 1): App Sandbox no arranca en un ejecutable de línea
	     de comandos sin identidad de bundle — libsystem_secinit.dylib crashea
	     (SIGTRAP) en _libsecinit_appsandbox al no poder resolver un
	     CFBundleIdentifier para crear el contenedor. Este plist se embebe en
	     el binario vía linker flags (ver Package.swift) para dar esa
	     identidad sin envolver el binario en un .app completo. -->
	<key>CFBundleIdentifier</key>
	<string>com.scaleback.batuta.logicpromcp</string>
	<key>CFBundleName</key>
	<string>LogicProMCP</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>LSUIElement</key>
	<true/>
	<key>NSAppleEventsUsageDescription</key>
	<string>Batuta envía Apple Events a Logic Pro para controlarlo (transporte, proyectos, mezcla).</string>
</dict>
</plist>
